# Base de datos (la pone Vercel sola al conectar Neon)
DATABASE_URL=

# Bot de Telegram (te lo da @BotFather)
TELEGRAM_BOT_TOKEN=
# Una clave secreta inventada por ti: solo letras, números, _ y - (ej. finanzas_2026_x9k2)
TELEGRAM_WEBHOOK_SECRET=
# Tu ID de chat: escríbele /start al bot y él te lo dice
TELEGRAM_CHAT_ID=

# Gemini (Google AI Studio) — solo se usa cuando el bot no entiende un mensaje
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Contraseña para abrir el dashboard en el navegador
DASHBOARD_PASSWORD=
