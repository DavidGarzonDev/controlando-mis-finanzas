# Base de datos (la pone Vercel sola al conectar Neon)
DATABASE_URL=

# Bot de Telegram (te lo da @BotFather)
TELEGRAM_BOT_TOKEN=
# Una clave secreta inventada por ti: solo letras, números, _ y - (ej. finanzas_2026_x9k2)
TELEGRAM_WEBHOOK_SECRET=
# Opcional: tu ID de chat. Si lo dejas vacío, la app te guía para conectar Telegram la primera vez que la abres.
TELEGRAM_CHAT_ID=

# Inteligencia artificial (opcional). Pon UNA clave; Pilas usa la primera que encuentre.
# Gemini tiene plan gratis: https://aistudio.google.com
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# Para elegir a la fuerza: gemini | claude | openai | groq | openrouter | deepseek | compatible
# IA_PROVEEDOR=
# Otro modelo del proveedor (ej. claude-haiku-5-5, gemini-3.1-flash-lite)
# IA_MODELO=
# Solo para "compatible" (cualquier servicio con el formato de OpenAI):
# IA_API_KEY=
# IA_BASE_URL=https://tu-servicio/v1

# Contraseña para abrir el dashboard (después llega un código de 6 dígitos a tu Telegram)
DASHBOARD_PASSWORD=

# Opcional: secreto para firmar las sesiones (32+ caracteres aleatorios). Si no está, se deriva de los demás secretos.
# AUTH_SECRET=

# Clave para el recordatorio diario por Telegram (Vercel la manda al llamar /api/cron). Mínimo 16 caracteres.
CRON_SECRET=

# Días del mes en que te pagan (para calcular cuánto puedes gastar por día). Por defecto quincena: 15,30
DIAS_DE_PAGO=15,30

# Solo para probar en tu computador sin Neon (ver README → "Probar en tu computador")
# NEON_LOCAL_ENDPOINT=http://localhost:4444/sql
